{
	"name": "sveltekit-github-stats",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "vp check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && prettier --check \"**/*.svelte\"",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "vp fmt && prettier --write \"**/*.svelte\"",
		"lint": "vp check && prettier --check \"**/*.svelte\"",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.2",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.2",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^26.1.1",
		"@vitest/browser-playwright": "^4.1.10",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"layerchart": "2.0.1",
		"playwright": "^1.61.1",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"typescript": "^7.0.2",
		"valibot": "^1.4.2",
		"vite": "^8.1.4",
		"vite-plus": "^0.2.4",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0",
		"wrangler": "^4.110.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"workerd"
		]
	}
}
